{
  "openapi": "3.0.0",
  "info": {
    "title": "LOD System API",
    "description": "Level of Detail character processing system for Valley of Echoes demo",
    "version": "1.0.0"
  },
  "paths": {
    "/characters/{characterId}/process": {
      "post": {
        "summary": "Process character for current turn",
        "parameters": [
          {
            "name": "characterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "world": { "$ref": "#/components/schemas/WorldState" },
                  "turn": { "type": "integer" },
                  "tier": { 
                    "type": "string", 
                    "enum": ["hero", "group", "background"] 
                  }
                },
                "required": ["world", "turn", "tier"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Character processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "characterId": { "type": "string" },
                    "processed": { "type": "boolean" },
                    "events": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Event" }
                    },
                    "statistics": { "$ref": "#/components/schemas/ProcessingStatistics" },
                    "stateChanges": {
                      "type": "object",
                      "additionalProperties": true
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/characters/{characterId}/promote": {
      "post": {
        "summary": "Promote character to higher LOD tier",
        "parameters": [
          {
            "name": "characterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fromTier": { 
                    "type": "string", 
                    "enum": ["background", "group", "hero"] 
                  },
                  "toTier": { 
                    "type": "string", 
                    "enum": ["group", "hero"] 
                  },
                  "reason": { "type": "string" },
                  "context": { "type": "object" }
                },
                "required": ["fromTier", "toTier", "reason"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Character promoted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "character": { "$ref": "#/components/schemas/Character" },
                    "previousTier": { "type": "string" },
                    "newTier": { "type": "string" },
                    "promotionEffects": {
                      "type": "array",
                      "items": { "type": "object" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/characters/{characterId}/demote": {
      "post": {
        "summary": "Demote character to lower LOD tier",
        "parameters": [
          {
            "name": "characterId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "fromTier": { 
                    "type": "string", 
                    "enum": ["hero", "group", "background"] 
                  },
                  "toTier": { 
                    "type": "string", 
                    "enum": ["group", "background"] 
                  },
                  "reason": { "type": "string" },
                  "populationGroupId": { "type": "string" }
                },
                "required": ["fromTier", "toTier", "reason"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Character demoted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "characterId": { "type": "string" },
                    "previousTier": { "type": "string" },
                    "newTier": { "type": "string" },
                    "populationGroupId": { "type": "string" },
                    "preservedData": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/population-groups/{groupId}/process": {
      "post": {
        "summary": "Process population group for current turn",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "world": { "$ref": "#/components/schemas/WorldState" },
                  "turn": { "type": "integer" },
                  "processingMode": {
                    "type": "string",
                    "enum": ["statistical", "sampled", "full"]
                  }
                },
                "required": ["world", "turn"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Population group processed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "groupId": { "type": "string" },
                    "processed": { "type": "boolean" },
                    "aggregateEvents": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Event" }
                    },
                    "statistics": { "$ref": "#/components/schemas/GroupStatistics" },
                    "promotionCandidates": {
                      "type": "array",
                      "items": { "type": "string" }
                    },
                    "groupChanges": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/population-groups/{groupId}/sample": {
      "post": {
        "summary": "Generate individual character samples from population group",
        "parameters": [
          {
            "name": "groupId",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sampleSize": { "type": "integer", "minimum": 1, "maximum": 10 },
                  "criteria": { "type": "object" },
                  "template": { "type": "object" }
                },
                "required": ["sampleSize"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Character samples generated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "samples": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Character" }
                    },
                    "groupId": { "type": "string" },
                    "sampleSize": { "type": "integer" },
                    "generationMethod": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/lod/metrics": {
      "get": {
        "summary": "Get LOD system performance metrics",
        "responses": {
          "200": {
            "description": "Performance metrics retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "totalCharacters": { "type": "integer" },
                    "tierDistribution": {
                      "type": "object",
                      "properties": {
                        "hero": { "type": "integer" },
                        "group": { "type": "integer" },
                        "background": { "type": "integer" }
                      }
                    },
                    "processingTimes": {
                      "type": "object",
                      "properties": {
                        "lastTurn": { "type": "number" },
                        "average": { "type": "number" },
                        "maximum": { "type": "number" }
                      }
                    },
                    "memoryUsage": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "number" },
                        "byTier": { "type": "object" }
                      }
                    },
                    "promotionStats": {
                      "type": "object",
                      "properties": {
                        "promotions": { "type": "integer" },
                        "demotions": { "type": "integer" },
                        "reasons": { "type": "object" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Character": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "lodTier": { "type": "string", "enum": ["hero", "group", "background"] },
          "populationGroupId": { "type": "string", "nullable": true },
          "attributes": { "type": "object" },
          "consciousness": { "type": "object" },
          "settlementLoyalty": { "type": "object" }
        }
      },
      "PopulationGroup": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "size": { "type": "integer" },
          "settlementId": { "type": "string" },
          "nodeId": { "type": "string" },
          "averageAttributes": { "type": "object" },
          "morale": { "type": "number" },
          "statistics": { "type": "object" }
        }
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "significance": { "type": "integer" },
          "description": { "type": "string" },
          "participants": { "type": "array", "items": { "type": "string" } },
          "consequences": { "type": "array", "items": { "type": "object" } }
        }
      },
      "ProcessingStatistics": {
        "type": "object",
        "properties": {
          "processingTime": { "type": "number" },
          "eventsGenerated": { "type": "integer" },
          "stateChanges": { "type": "integer" },
          "memoryUsed": { "type": "number" }
        }
      },
      "GroupStatistics": {
        "type": "object",
        "properties": {
          "averageHappiness": { "type": "number" },
          "productivityLevel": { "type": "number" },
          "cohesionIndex": { "type": "number" },
          "growthRate": { "type": "number" },
          "resourceGeneration": { "type": "object" }
        }
      },
      "WorldState": {
        "type": "object",
        "properties": {
          "settlements": { "type": "array" },
          "characters": { "type": "array" },
          "turn": { "type": "integer" },
          "globalEvents": { "type": "array" }
        }
      }
    }
  }
}