{
  "openapi": "3.0.0",
  "info": {
    "title": "Demo World API",
    "version": "1.0.0",
    "description": "API contracts for demo world save flow consistency"
  },
  "paths": {
    "/api/demo/import-edit": {
      "post": {
        "summary": "Import demo world for editing",
        "description": "Load a demo world with edit capabilities, ensuring save flows match user-created content",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "demoId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "ID of the demo world to import"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "preserveOwnership": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether to preserve demo ownership flags"
                      },
                      "enableSave": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether to enable save functionality"
                      }
                    }
                  }
                },
                "required": ["demoId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo world successfully imported",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "demoWorld": { "$ref": "#/components/schemas/DemoWorld" },
                    "saveFlowEnabled": { "type": "boolean" },
                    "ownershipPreserved": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string" },
                    "details": { "type": "object" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Demo world not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "enum": ["DEMO_NOT_FOUND"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/launch": {
      "post": {
        "summary": "Launch demo world for exploration",
        "description": "Start a demo world in exploration mode with consistent save behavior",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "demoId": {
                    "type": "string",
                    "format": "uuid",
                    "description": "ID of the demo world to launch"
                  },
                  "mode": {
                    "type": "string",
                    "enum": ["exploration", "tutorial"],
                    "default": "exploration",
                    "description": "Launch mode for the demo"
                  }
                },
                "required": ["demoId"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Demo world successfully launched",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "demoWorld": { "$ref": "#/components/schemas/DemoWorld" },
                    "mode": { "type": "string" },
                    "saveConsistencyEnabled": { "type": "boolean" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/content/save": {
      "put": {
        "summary": "Unified save endpoint for all content",
        "description": "Save content using consistent flows regardless of demo or user origin",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "object",
                    "properties": {
                      "interactions": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/Interaction" }
                      },
                      "nodes": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/Node" }
                      },
                      "characters": {
                        "type": "array",
                        "items": { "$ref": "#/components/schemas/Character" }
                      }
                    }
                  },
                  "source": {
                    "type": "string",
                    "enum": ["editor", "auto", "demo-import", "demo-launch"],
                    "description": "Source of the save operation"
                  },
                  "options": {
                    "type": "object",
                    "properties": {
                      "validateOwnership": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether to validate content ownership"
                      },
                      "resolveConflicts": {
                        "type": "boolean",
                        "default": true,
                        "description": "Whether to attempt automatic conflict resolution"
                      }
                    }
                  }
                },
                "required": ["content", "source"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Content saved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean", "enum": [true] },
                    "savedEntities": {
                      "type": "array",
                      "items": { "type": "string", "format": "uuid" }
                    },
                    "conflictsResolved": { "type": "number" },
                    "ownershipUpdated": { "type": "number" }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Save conflicts detected",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": { "type": "string", "enum": ["SAVE_CONFLICTS"] },
                    "conflicts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "entityId": { "type": "string", "format": "uuid" },
                          "conflictType": { "type": "string" },
                          "resolution": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/content/validate": {
      "post": {
        "summary": "Validate content consistency",
        "description": "Validate that demo and user content follow consistent patterns",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "content": { "$ref": "#/components/schemas/ContentValidation" },
                  "strictMode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Whether to enforce strict validation rules"
                  }
                },
                "required": ["content"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Content validation completed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": { "type": "boolean" },
                    "issues": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": { "type": "string" },
                          "severity": { "type": "string", "enum": ["error", "warning"] },
                          "message": { "type": "string" },
                          "entityId": { "type": "string", "format": "uuid" }
                        }
                      }
                    },
                    "consistency": {
                      "type": "object",
                      "properties": {
                        "demoContent": { "type": "number" },
                        "userContent": { "type": "number" },
                        "mixedContent": { "type": "number" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DemoWorld": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "content": { "$ref": "#/components/schemas/DemoContent" },
          "metadata": { "$ref": "#/components/schemas/DemoMetadata" }
        },
        "required": ["id", "name", "content"]
      },
      "DemoContent": {
        "type": "object",
        "properties": {
          "interactions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Interaction" }
          },
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Node" }
          },
          "characters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Character" }
          }
        }
      },
      "DemoMetadata": {
        "type": "object",
        "properties": {
          "author": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "difficulty": { "type": "string", "enum": ["beginner", "intermediate", "advanced"] },
          "estimatedDuration": { "type": "number", "description": "Duration in minutes" }
        }
      },
      "Interaction": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "type": { "type": "string" },
          "ownership": { "type": "string", "enum": ["demo", "user", "mixed"] },
          "participants": { "type": "array", "items": { "type": "string", "format": "uuid" } },
          "data": { "type": "object" }
        },
        "required": ["id", "type", "ownership"]
      },
      "Node": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "type": { "type": "string" },
          "ownership": { "type": "string", "enum": ["demo", "user", "mixed"] },
          "data": { "type": "object" }
        },
        "required": ["id", "name", "type", "ownership"]
      },
      "Character": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "ownership": { "type": "string", "enum": ["demo", "user", "mixed"] },
          "data": { "type": "object" }
        },
        "required": ["id", "name", "ownership"]
      },
      "ContentValidation": {
        "type": "object",
        "properties": {
          "interactions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Interaction" }
          },
          "nodes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Node" }
          },
          "characters": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Character" }
          }
        }
      }
    }
  }
}